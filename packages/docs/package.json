{
  "$schema": "http://json.schemastore.org/package",
  "name": "@taiko/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run generate:api && astro dev",
    "build": "npm run generate:api && astro build",
