    "generate:api": "npm --prefix ../taiko run doc:api && node scripts/generate-api-docs.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.5",
    "astro": "^6.4.8",
    "sharp": "^0.35.3"
  }
